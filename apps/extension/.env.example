# Latch HTTP API (background fetch). Defaults to Render Go backend if unset.
PLASMO_PUBLIC_LATCH_API_URL=https://latch-backend.onrender.com
# PLASMO_PUBLIC_LATCH_API_URL=https://v0-latch-stellar.vercel.app
# PLASMO_PUBLIC_LATCH_API_URL=http://localhost:3000

# Latch Market HTTP API (prices feed). Defaults to {LATCH_API_URL}/v1 when unset.
# PLASMO_PUBLIC_LATCH_MARKET_API_URL=https://latch-backend.onrender.com/v1

# Shared WebAuthn RP ID (hostname only). Must match Latch API WEBAUTHN_RP_ID.
# Passkeys are bound to this domain so extension, web, and native apps can share them.
# chromeExtensionId is still sent on ceremonies as the origin hint (chrome-extension://…), not as rp.id.
PLASMO_PUBLIC_WEBAUTHN_RP_ID=uselatch.app

# WebAuthn verifier contract C-address (must match Latch API). Separate per network:
# PLASMO_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=CDBBGLSWWHWK52REY7GK5HWAQGAJJ4GP5O75LOM3F4INN6W4KT6DPBVY
# PLASMO_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS_MAINNET=CD32576TIHJS5CPPB7TGLK2O5X6JENBZUWMPYXCVNWS62KAZCAZSASRD

# Stellar network — build-time default when latch.network unset ("testnet" | "mainnet")
PLASMO_PUBLIC_STELLAR_NETWORK=testnet

# Horizon / Soroban (testnet overrides; in-app switch uses public mainnet defaults unless set)
PLASMO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
PLASMO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# PLASMO_PUBLIC_HORIZON_MAINNET_URL=https://horizon.stellar.org
# PLASMO_PUBLIC_SOROBAN_RPC_MAINNET_URL=https://mainnet.sorobanrpc.com

# Bundler public G for local swap XDR building (Aquarius local path + Soroswap aggregator on mainnet).
# NOT a secret — BUNDLER_SECRET lives only in the Latch API repo.
# Aquarius testnet product path uses POST /api/transaction/build-swap (API reads BUNDLER_SECRET).
# Mainnet Soroswap builds aggregator invoke XDR in the extension, then Latch prepare-sign —
# PLASMO_PUBLIC_LATCH_FEE_PAYER_G_MAINNET is REQUIRED for mainnet swap (must match Latch API bundler G).
# Never falls back to the testnet fee-payer on mainnet.
# PLASMO_PUBLIC_LATCH_FEE_PAYER_G=GBL4FMN3MPLPA2IS7T2K5VAGGVT4WJWJ24YXYFAHIFOGGCVEM6WVVAQA
# PLASMO_PUBLIC_LATCH_FEE_PAYER_G_MAINNET=GALFAHYQOCWEHHETOX634P3VPJHRZWB5RON2JCTAMY3LV3KW6QICAGNX

# Soroswap API key (required for mainnet swap /quote). Get one at https://api.soroswap.finance
# PLASMO_PUBLIC_SOROSWAP_API_KEY=sk_...

# MoonPay publishable key for Fund on-ramp (pk_test_… sandbox or pk_live_…). Not a secret.
# PLASMO_PUBLIC_MOONPAY_API_KEY=pk_test_...

# Issue #61 diagnostic: before submit-webauthn / submit-delegated, locally attach
# signed auth and re-simulate (enforcing mode), then log recording vs enforcing
# footprint to the service worker console as `[latch][issue-61] underestimated=…`.
# Never blocks submit. Requires PLASMO_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS for passkey.
# PLASMO_PUBLIC_DEBUG_ENFORCING_SIM=1
# PLASMO_PUBLIC_DEBUG_ENFORCING_SIM=1
# PLASMO_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=
